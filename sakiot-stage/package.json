{
	"name": "sakiot-stage",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "bun run check:ui-boundaries && biome check . && tsc && tsc -p tsconfig.e2e.json && bun run build:bundle",
		"build:bundle": "vite build",
		"check:ui-boundaries": "bun scripts/check-ui-boundaries.ts",
		"deploy": "bun run build && ./scripts/deploy.sh",
		"generate:api-types": "bun scripts/generate-api-types.ts",
		"check:api-types": "bun scripts/generate-api-types.ts --check",
		"preview": "vite preview",
		"test": "bun test src",
		"test:e2e": "playwright test",
		"test:e2e:ci": "playwright test --grep-invert @visual",
		"lint": "biome lint .",
		"format": "biome check --write ."
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@reduxjs/toolkit": "^2",
		"@tailwindcss/postcss": "^4.1.7",
		"@types/node": "^25.6.0",
		"@wavesurfer/react": "^1.0.12",
		"async-mutex": "^0.5.0",
		"clsx": "^2.1.1",
		"hls.js": "^1.6.16",
		"lucide-react": "^1.31.0",
		"react": "^19",
		"react-aria-components": "~1.19.0",
		"react-dom": "^19",
		"react-redux": "^9.2.0",
		"react-router-dom": "^7.0",
		"tailwind-merge": "^3.6.0",
		"waveform-data": "^4.3.0",
		"wavesurfer.js": "^7.12.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@babel/core": "^8.0.1",
		"@biomejs/biome": "^2.4.12",
		"@playwright/test": "^1.62.1",
		"@rolldown/plugin-babel": "^0.2.3",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/devtools": "^0.1.8",
		"@vitejs/plugin-react": "^6.0.1",
		"autoprefixer": "^10.4.8",
		"babel-plugin-react-compiler": "^1.0.0",
		"postcss": "^8.4.16",
		"rollup-plugin-visualizer": "^7.0.1",
		"tailwindcss": "^4.1.7",
		"typescript": "^7.0.2",
		"vite": "^8.0.0"
	}
}
