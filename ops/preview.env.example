# Preview runtime profile, SHARED by every preview slot on the VPS. Installed
# once as /etc/sakiot/preview.env. The deploy engine derives each slot's
# values from the slot name: ports (8903 + hash), database
# (sakiot_preview_<slot>), data/release dirs (/var/lib/sakiot-preview-<slot>,
# /srv/sakiot-preview-<slot>), units (sakiot-preview-<slot>-*), and the
# subdomain (<slot>.preview.patrykstyla.com). Keep the base tokens
# (sakiot-preview, sakiot_preview, preview.patrykstyla.com, PORT) as-is.

SAKIOT_REPOSITORY_URL=https://github.com/OWNER/REPOSITORY.git
SAKIOT_ENV_FILE=/etc/sakiot/preview.env

# Per-slot layout is derived by the engine; base values live here.
SAKIOT_DATA_DIR=/var/lib/sakiot-preview/data
SAKIOT_DEPLOY_STATE_DIR=/var/lib/sakiot-preview/deploy
SAKIOT_RELEASE_ROOT=/srv/sakiot-preview/releases
SAKIOT_CURRENT_ROOT=/srv/sakiot-preview/current
SAKIOT_CACHE_DIR=/var/cache/sakiot-preview
# Production promotions and Cargo outputs are intentionally shared; the
# deployer serializes build-and-copy operations between instances.
SAKIOT_CARGO_TARGET_DIR=/var/cache/sakiot/cargo-target
SAKIOT_PROMOTION_ROOT=/var/cache/sakiot/promotions
SAKIOT_PRODUCTION_ENV_FILE=/etc/sakiot/production.env
SAKIOT_FRONTEND_ROOT=/var/www/preview.patrykstyla.com

# Base preview port; the engine rewrites the health/registry URLs per slot
# (8903 + hash(slot)), and the per-slot port lands in each release's
# service.env so the web server binds its own.
SAKIOT_WEB_HEALTH_URL=http://127.0.0.1:8903/healthz
SAKIOT_WEB_REGISTRY_URL=http://127.0.0.1:8903/internal/fbi-agent/grpc-endpoints

# Preview systemd unit names (the bot prefix is unused — preview slots run no
# FBI Agent — but the engine reads it from the env file). The engine appends
# the slot name.
SAKIOT_WEB_UNIT=sakiot-preview-web.service
SAKIOT_BOT_UNIT_PREFIX=sakiot-preview-fbi-agent@

SAKIOT_SYSTEMCTL_USE_SUDO=1
SAKIOT_KEEP_RELEASES=5
SAKIOT_ROLLBACK_FORCE_REBUILD=0

# The preview databases are disposable, so skip the encrypted pre-migrate
# backup (migrations still run). The engine rewrites the DB name per slot.
SAKIOT_SKIP_DB_BACKUP=1
DATABASE_URL=postgres://sakiot:replace_me@127.0.0.1/sakiot_preview
# Shared test master is safe because SQLx creates a fresh temporary database
# for every test. Never point this at staging or production.
SAKIOT_TEST_DATABASE_URL=postgres://sakiot_test:replace_me@127.0.0.1/sakiot_test
BACKUP_DATABASE_URL=postgres://sakiot:replace_me@127.0.0.1/sakiot_preview
BACKUP_DIR=/var/lib/sakiot-preview/backups
AGE_RECIPIENT=age1replace_me

# Optional media archive settings mirror staging; start disabled for branches
# that do not touch media until the archive acceptance passes.
SAKIOT_MEDIA_ARCHIVE_ENABLED=0

# Preview slots deploy the web server and frontend only — no FBI Agent bot.
# Login is dev-login only; Discord OAuth is never used. The web server still
# requires these two at startup, so any non-empty placeholder works here.
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=unused_placeholder
JWT_ACCESS_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me
# Dev login (the only login on preview hosts). Backend requires BOTH:
DEV_ACCOUNT_ID=000000000000000000
DEV_LOGIN_SECRET=replace_with_a_strong_secret
# Optional: bake the secret into the bundle to skip the prompt. This makes it
# readable in the public client JS; leave unset to be prompted on click instead.
# VITE_DEV_LOGIN_SECRET=

# Email for per-slot HTTPS certificates (certbot). ops/preview-slot.sh reads
# it from this shared file, so no need to pass it per slot.
CERTBOT_EMAIL=you@example.com

# Cloudflare API token (Zone:DNS edit) used by ops/preview-slot.sh to create
# and delete each slot's DNS record. Read from this file when not passed on
# the command line. The deploy engine and web server ignore it.
CLOUDFLARE_API_TOKEN=replace_with_zone_dns_token
COOKIE_DOMAIN=preview.patrykstyla.com
DISCORD_REDIRECT_URI=https://preview.patrykstyla.com/api/discord_login
CORS_ALLOWED_ORIGIN=https://preview.patrykstyla.com
OAUTH_ALLOWED_OPENER_ORIGINS=https://preview.patrykstyla.com
FBI_AGENT_REGISTRY_SECRET=replace_me
HOST=127.0.0.1
PORT=8903

# Embedded into the frontend bundle at build time (Vite reads VITE_* from the
# environment). The engine rewrites this per slot so each slot's UI points at
# its own API origin.
VITE_API_URL=https://preview.patrykstyla.com/api/
