[Unit]
Description=Sakiot web server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
# UMask keeps production's data out of reach of the staging and preview
# users, like theirs is from each other.
User=sakiot
Group=sakiot
UMask=0007
WorkingDirectory=/var/lib/sakiot/data
EnvironmentFile=/etc/sakiot/production.env
EnvironmentFile=/srv/sakiot/current/web/service.env
ExecStart=/srv/sakiot/current/web/web_server
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
# Read-only filesystem except the instance's own data directory.
ProtectSystem=strict
ReadWritePaths=/var/lib/sakiot/data
PrivateDevices=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
