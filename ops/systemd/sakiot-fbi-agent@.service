[Unit]
Description=Sakiot FBI Agent release %i
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=sakiot
Group=sakiot
WorkingDirectory=/var/lib/sakiot/data
EnvironmentFile=/etc/sakiot/production.env
EnvironmentFile=/srv/sakiot/releases/%i/fbi-agent/service.env
ExecStart=/srv/sakiot/releases/%i/fbi-agent/fbi_agent
Restart=on-failure
RestartSec=2
TimeoutStopSec=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
# Read-only filesystem except the instance's own data directory.
ProtectSystem=strict
ReadWritePaths=/var/lib/sakiot/data
PrivateDevices=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
