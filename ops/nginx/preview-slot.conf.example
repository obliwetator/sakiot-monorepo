# Preview slot vhost; ops/preview-slot.sh renders SLOT/PORT and installs it
# under /etc/nginx/sites-available/<slot>.preview.<domain>.

# Reused connections to the slot's web server. keepalive_timeout stays under
# actix-web's 5 s keep-alive, so nginx never reuses a socket the server is
# about to close.
upstream SLOT_web {
    server 127.0.0.1:PORT;
    keepalive 16;
    keepalive_timeout 4s;
}

server {
    listen 80;
    listen [::]:80;
    # Server-wide, so it also covers the 443 listener certbot adds; plain
    # HTTP/1.1 on port 80 keeps working.
    http2 on;
    server_name SLOT.preview.patrykstyla.com;
    root /var/www/SLOT.preview.patrykstyla.com;

    # Preview slots are reachable by anyone with the URL; their only login is
    # dev login. Uncomment to require HTTP basic auth as well (create the file
    # with `htpasswd -c /etc/nginx/.htpasswd-preview <user>`).
    # auth_basic "Preview";
    # auth_basic_user_file /etc/nginx/.htpasswd-preview;

    # API responses (including OAuth and media) carry their own policy. Do not
    # add the static-page CSP to /api/: it would block the OAuth nonce script.
    # An empty Connection header keeps the upstream connection open for reuse.
    location /api/ {
        proxy_pass http://SLOT_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
    # Realtime dashboard socket: forward the WebSocket upgrade. The server
    # sends a heartbeat every 20 s, well inside the read timeout.
    location = /api/realtime {
        proxy_pass http://SLOT_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 75s;
    }
    location / {
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: wss:; img-src 'self' data: https:; font-src 'self' data:; media-src 'self' blob: https:; worker-src 'self' blob:" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        try_files $uri /index.html;
    }
    # don't cache HTML/version.json (assets are hash-named):
    # These exact locations need the same headers: their Cache-Control
    # add_header directives prevent inheritance from location /.
    location = /index.html {
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: wss:; img-src 'self' data: https:; font-src 'self' data:; media-src 'self' blob: https:; worker-src 'self' blob:" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    }
    location = /version.json {
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: wss:; img-src 'self' data: https:; font-src 'self' data:; media-src 'self' blob: https:; worker-src 'self' blob:" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    }
}
