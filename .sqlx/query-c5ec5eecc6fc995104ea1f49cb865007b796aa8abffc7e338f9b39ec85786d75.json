{
  "db_name": "PostgreSQL",
  "query": "SELECT r.role_id,\n                r.name,\n                r.permission,\n                COALESCE(COUNT(ur.user_id), 0)::bigint AS member_count\n         FROM roles r\n         LEFT JOIN user_roles ur ON ur.role_id = r.role_id\n         WHERE r.guild_id = $1\n         GROUP BY r.role_id, r.name, r.permission\n         ORDER BY r.role_id = $1, r.role_id",
