  "query": "SELECT id,\n                state,\n                last_segment_index,\n                (EXTRACT(EPOCH FROM next_fragment_start_at) * 1000)::bigint AS next_fragment_start_ms\n           FROM recording_sessions\n          WHERE guild_id = $1 AND user_id = $2 AND state <> 'finalized'\n          ORDER BY started_at DESC, id DESC\n          LIMIT 1\n          FOR UPDATE",
