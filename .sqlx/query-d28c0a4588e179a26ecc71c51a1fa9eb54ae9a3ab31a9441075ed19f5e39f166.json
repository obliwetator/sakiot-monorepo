  "query": "SELECT af.start_ts,\n                af.end_ts,\n                (\n                    af.end_ts IS NULL\n                    AND af.reaped IS FALSE\n                    AND EXISTS (SELECT 1 FROM live_audio_files live WHERE live.id = af.id)\n                ) AS live\n           FROM audio_files af\n          WHERE af.file_name = $1",
