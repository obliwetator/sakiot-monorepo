  "query": "SELECT rs.id,\n                  rs.starting_channel_id,\n                  ARRAY(SELECT DISTINCT channel_id\n                          FROM audio_files\n                         WHERE recording_session_id = rs.id) AS \"channels!\"\n             FROM recording_sessions rs\n            WHERE rs.id = ANY($1)\n              AND rs.guild_id = $2\n              AND rs.deletion_requested_at IS NULL",
